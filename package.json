{
  "name": "mdpress",
  "version": "0.1.0",
  "description": "Impagina Markdown in PDF e DOCX con template personalizzabili",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "mdpress": "bin/mdpress.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "tsx src/cli/index.ts",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "image-size": "^2.0.4",
    "jszip": "^3.10.2",
    "nanoid": "^6.0.1",
    "open": "^11.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "source-map-js": "^1.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
