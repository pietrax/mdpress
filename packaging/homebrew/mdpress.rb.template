class Mdpress < Formula
  desc "Lay out Markdown as PDF and DOCX with customizable templates"
  homepage "https://github.com/pietrax/mdpress"
  url "https://github.com/pietrax/mdpress/releases/download/v__VERSION__/mdpress-__VERSION__.tar.gz"
  sha256 "__SHA256__"
  license "MIT"

  depends_on "node"
  depends_on "pandoc"
  depends_on "typst"

  def install
    libexec.install Dir["*"]
    (bin/"mdpress").write_env_script libexec/"bin/mdpress.js", PATH: "#{Formula["node"].opt_bin}:$PATH"
  end

  test do
    system bin/"mdpress", "doctor"
    (testpath/"sample.md").write("---\ntitle: Sample\n---\n\n# Hello\n\nText.\n")
    system bin/"mdpress", "render", testpath/"sample.md", "-f", "pdf,docx"
    assert_path_exists testpath/"sample.pdf"
    assert_path_exists testpath/"sample.docx"
  end
end
